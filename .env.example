APP_NAME=FitTwin API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://fitwin:fitwin@localhost:5432/fitwin
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=fitwin
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600
UPLOAD_MAX_BYTES=10485760
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true
OOTDIFFUSION_PATH=vendor/OOTDiffusion
OOTDIFFUSION_GPU_ID=0
OOTDIFFUSION_STEPS=20
OOTDIFFUSION_SCALE=2.0
OOTDIFFUSION_SEED=-1
TRELLIS_PATH=vendor/TRELLIS
TRELLIS_MODEL_ID=microsoft/TRELLIS-image-large
TRELLIS_SEED=1
TRELLIS_MESH_SIMPLIFY=0.95
TRELLIS_TEXTURE_SIZE=1024
PRODUCT_STORE_BASE_URL=https://shop.fitwin.example/products

